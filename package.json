{
  "name": "readlocal",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first offline desktop reader for PDF and EPUB",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "epubjs": "^0.3.93",
    "chokidar": "^4.0.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.readlocal.app",
    "productName": "ReadLocal",
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": "nsis" }
  },
  "repository": { "type": "git", "url": "https://github.com/salaudeenabdulkabir/ReadLocal.git" },
  "homepage": "https://github.com/salaudeenabdulkabir/ReadLocal"
}
